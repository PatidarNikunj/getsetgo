# Local infrastructure settings for docker-compose.yml.
# Copy to .env and replace every "change-me" (pnpm infra:env does this with random values).
# .env is git-ignored; never commit real secrets.

# ---------- PostgreSQL 18 ----------
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Per-service databases (each login can only reach its own database)
API_DB_NAME=getsetgo_api
API_DB_USER=getsetgo_api
API_DB_PASSWORD=change-me
AI_DB_NAME=getsetgo_ai
AI_DB_USER=getsetgo_ai
AI_DB_PASSWORD=change-me

# ---------- MongoDB 8.0 ----------
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me

API_MONGO_DB=getsetgo_api
API_MONGO_USER=getsetgo_api
API_MONGO_PASSWORD=change-me
AI_MONGO_DB=getsetgo_ai
AI_MONGO_USER=getsetgo_ai
AI_MONGO_PASSWORD=change-me

# ---------- Redis 8 ----------
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------- Admin GUIs (only with `pnpm infra:tools`) ----------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@getsetgo.local
PGADMIN_PASSWORD=change-me
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
REDISINSIGHT_PORT=5540

# ---------- Service-to-service auth (apps/api -> apps/ai) ----------
SERVICE_JWT_SECRET=change-me
