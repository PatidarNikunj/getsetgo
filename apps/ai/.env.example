# apps/ai settings. Generated with real local values by `pnpm infra:env` (from the repo root).
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://getsetgo_ai:change-me@localhost:5432/getsetgo_ai
MONGODB_URI=mongodb://getsetgo_ai:change-me@localhost:27017/getsetgo_ai?authSource=getsetgo_ai
MONGODB_DB=getsetgo_ai

# Shared with apps/api; must be at least 32 characters.
SERVICE_JWT_SECRET=change-me

# Claude: create a key at https://console.anthropic.com (leave empty to disable summaries).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Observability (optional; off when empty). See docs/observability.md.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
