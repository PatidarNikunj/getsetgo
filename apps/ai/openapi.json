{
  "components": {
    "schemas": {
      "Liveness": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Liveness",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "mongo": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Mongo",
            "type": "string"
          },
          "postgres": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Postgres",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "postgres",
          "mongo"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "SummaryRequest": {
        "properties": {
          "content": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "note_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Note Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "note_id",
          "title",
          "content"
        ],
        "title": "SummaryRequest",
        "type": "object"
      },
      "SummaryResponse": {
        "properties": {
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "key_points": {
            "items": {
              "type": "string"
            },
            "title": "Key Points",
            "type": "array"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "summary",
          "key_points",
          "model",
          "input_tokens",
          "output_tokens"
        ],
        "title": "SummaryResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "getsetgo AI service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/summaries": {
      "post": {
        "operationId": "create_summary_v1_summaries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid service token"
          },
          "422": {
            "description": "Claude declined to summarize the note"
          },
          "502": {
            "description": "Claude failed to produce a summary"
          },
          "503": {
            "description": "Claude is not configured or temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Summary",
        "tags": [
          "summaries"
        ]
      }
    }
  }
}
