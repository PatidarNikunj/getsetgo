# apps/api settings. Generated with real local values by `pnpm infra:env` (from the repo root).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://getsetgo_api:change-me@localhost:5432/getsetgo_api
MONGODB_URI=mongodb://getsetgo_api:change-me@localhost:27017/getsetgo_api?authSource=getsetgo_api
REDIS_URL=redis://:change-me@localhost:6379/0

# Internal AI service and the secret shared with it (at least 32 characters).
AI_SERVICE_URL=http://localhost:8000
SERVICE_JWT_SECRET=change-me

# Comma-separated browser origins allowed to call the API (the two Next.js apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Observability (optional; off when empty) — see docs/observability.md ----------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# GA4 Measurement Protocol (server-side events). Needs both values.
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ---------- Sign-in (specs/001-oauth-login) — see docs/backends.md ----------
# development | test | production. Test-only features need development or test.
APP_ENV=development
# Signs the 15-minute session cookie (at least 32 characters; generated by pnpm infra:env).
AUTH_JWT_SECRET=change-me
# Who may sign in, comma-separated: verified emails, github:<login>, test:<login>, test:<prefix>*.
AUTH_ALLOWLIST=test:e2e-*,test:alice,test:bob
# Built-in fake provider for local testing and e2e. Refused when APP_ENV=production.
AUTH_TEST_PROVIDER=enabled
# Google OAuth client (both or neither). Redirect URIs: <web origin>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One GitHub OAuth app per web app, as JSON keyed by web origin, e.g.
# {"http://localhost:3000":{"clientId":"…","clientSecret":"…"}}
GITHUB_OAUTH_APPS=
# reCAPTCHA v3 secret; bot check is skipped when empty.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Requests per minute per client IP (default 120). Raise locally if e2e runs hit the limit.
RATE_LIMIT_PER_MINUTE=120

# Proxies in front of the API (1 locally; 2 on Render behind the Vercel rewrite).
TRUST_PROXY_HOPS=1
