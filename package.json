{
  "name": "getsetgo",
  "private": true,
  "description": "A fun learning monorepo for modern web, backend and AI technologies.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:env": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:tools": "docker compose --profile tools up -d --wait",
    "infra:down": "docker compose --profile tools --profile apps down",
    "infra:reset": "docker compose --profile tools --profile apps down --volumes",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "stack:up": "docker compose --profile apps up -d --build --wait",
    "stack:down": "docker compose --profile apps down"
  },
  "devDependencies": {
    "@getsetgo/config": "workspace:*",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
